@import("../core/runtime.zag")
@import("../core/buffer.zag") as buf
@import("../core/json.zag") as json
@import("../storage/files.zag") as files
@import("../server/net.zag") as net
@import("local_token.zag") as token
// A real, narrowly permissioned local test client, not filesystem privileges for
// a website. Only one synthetic file is ever eligible. Grants are volatile,
// single-read, provider/model/test-bound, and expire after five minutes.
// Generation uses the same HTTP parser/session/tool path as external clients,
// transported over a private nonblocking socketpair within Zag.
struct Probe {
    root: buf.Buffer, id: buf.Buffer, model: buf.Buffer, secret: buf.Buffer,
    history: buf.Buffer, outgoing: buf.Buffer, incoming: buf.Buffer, error: buf.Buffer,
    provider: i32, state: i32, directory_fd: i64, file_created: bool, cleanup_ok: bool, fd: i64, offset: i32, reads: i32, denied: i32,
    deadline: i64, granted: bool, pending: bool, changed: bool, cleanup_session: bool,
}
fn make() Probe {
    return Probe{.root=buf.make(4096),.id=buf.make(96),.model=buf.make(256),.secret=buf.make(128),
        .history=buf.make(32768),.outgoing=buf.make(65536),.incoming=buf.make(65536),.error=buf.make(128),
        .provider=0,.state=0,.directory_fd=0 - 1,.file_created=false,.cleanup_ok=true,.fd=0 - 1,.offset=0,.reads=0,.denied=0,.deadline=0,
        .granted=false,.pending=false,.changed=false,.cleanup_session=false};
}
fn state_name(state: i32) []u8 {
    if (state==1) { return "PERMISSION_REQUIRED"; }
    if (state==2) { return "WAITING_FOR_TOOL"; }
    if (state==3) { return "WAITING_FOR_REPLY"; }
    if (state==4) { return "PASSED"; }
    if (state==5) { return "FAILED"; }
    if (state==6) { return "REVOKED"; }
    return "IDLE";
}
fn active(p: *Probe) bool { return p.*.state==2 || p.*.state==3; }
fn close_transport(p: *Probe) void {
    if (p.*.fd>=0) { net.close(p.*.fd); p.*.fd=0 - 1; }
    p.*.pending=false; buf.clear(&p.*.outgoing); buf.clear(&p.*.incoming); p.*.offset=0;
}
fn remove_file(p: *Probe) void {
    if (p.*.directory_fd<0) { return; }
    if (p.*.file_created) {
        let path: buf.Buffer=buf.make(32); buf.add(&path,"bridge-probe.txt"); buf.byte(&path,0);
        let rc: i64=_zag_raw_syscall(263,p.*.directory_fd,path.data as i64,0,0,0,0); buf.free(&path);
        if (rc==0 || rc==0 - 2) { p.*.file_created=false; }
        else { p.*.cleanup_ok=false; buf.copy(&p.*.error,"SYNTHETIC_FILE_CLEANUP_FAILED"); }
    }
    net.close(p.*.directory_fd); p.*.directory_fd=0 - 1;
}
fn terminal(p: *Probe, state: i32, error: []u8) void {
    p.*.granted=false; p.*.state=state; p.*.changed=true; p.*.cleanup_session=true;
    close_transport(p); buf.copy(&p.*.error,error); remove_file(p);
    buf.clear(&p.*.secret); buf.clear(&p.*.history);
}
fn prepare(p: *Probe, root: []u8, provider: i32, model: []u8) bool {
    if (active(p)) { return false; }
    close_transport(p); remove_file(p); buf.clear(&p.*.error); buf.clear(&p.*.history);
    p.*.cleanup_ok=true; p.*.file_created=false; p.*.provider=provider; p.*.reads=0; p.*.denied=0; p.*.granted=false; p.*.cleanup_session=false;
    buf.copy(&p.*.model,model); buf.copy(&p.*.root,root); buf.add(&p.*.root,"/filesystem-probe");
    let dir: buf.Buffer=buf.make(4096); buf.copy(&dir,buf.view(&p.*.root)); buf.byte(&dir,0);
    let made: i64=_zag_raw_syscall(83,dir.data as i64,448,0,0,0,0); buf.free(&dir);
    if ((made!=0 && made!=0 - 17) || !files.secure_root(buf.view(&p.*.root))) { terminal(p,5,"PROBE_DIRECTORY_DENIED"); return false; }
    let directory: buf.Buffer=buf.make(4096); buf.copy(&directory,buf.view(&p.*.root)); buf.byte(&directory,0);
    p.*.directory_fd=_zag_raw_syscall(2,directory.data as i64,65536 | 131072 | 524288,0,0,0,0); buf.free(&directory);
    if (p.*.directory_fd<0) { terminal(p,5,"PROBE_DIRECTORY_DENIED"); return false; }
    let entropy: buf.Buffer=buf.make(128);
    if (!token.generate(&entropy)) { buf.free(&entropy); terminal(p,5,"ENTROPY_UNAVAILABLE"); return false; }
    buf.copy(&p.*.id,"probe_"); buf.add(&p.*.id,entropy.data[9..41]);
    if (!token.generate(&entropy)) { buf.free(&entropy); terminal(p,5,"ENTROPY_UNAVAILABLE"); return false; }
    buf.copy(&p.*.secret,"BRIDGE_PROBE_"); buf.add(&p.*.secret,entropy.data[9..73]); buf.free(&entropy);
    if (!files.save(buf.view(&p.*.root),"bridge-probe.txt",buf.view(&p.*.secret))) { terminal(p,5,"PROBE_FILE_CREATE_FAILED"); return false; }
    p.*.file_created=true; p.*.state=1; p.*.deadline=_zag_clock_monotonic_ms()+300000; p.*.changed=true; return true;
}
fn allow(p: *Probe, id: []u8, confirmed: bool) bool {
    if (p.*.state!=1 || !confirmed || !buf.eq(id,buf.view(&p.*.id)) || _zag_clock_monotonic_ms()>=p.*.deadline) { return false; }
    // The nonce stays on disk and in trusted memory, never in the initial prompt.
    buf.copy(&p.*.history,"[{\"role\":\"user\",\"content\":\"Read bridge-probe.txt using read_file. This is a permissioned local-client test: you have no direct filesystem access. Do not invent its contents. After the tool result, reply with exactly its text and nothing else.\"}]");
    p.*.granted=true; p.*.state=2; p.*.pending=true; p.*.changed=true; return true;
}
fn render(p: *Probe, out: *buf.Buffer) void {
    buf.add(out,"{\"id\":"); buf.json(out,buf.view(&p.*.id)); buf.add(out,",\"state\":"); buf.json(out,state_name(p.*.state));
    buf.add(out,",\"provider_id\":"); buf.integer(out,p.*.provider as i64); buf.add(out,",\"model\":"); buf.json(out,buf.view(&p.*.model));
    buf.add(out,",\"path\":"); let path: buf.Buffer=buf.make(4096);
    if (p.*.root.len>0) { buf.add(&path,buf.view(&p.*.root)); buf.add(&path,"/bridge-probe.txt"); }
    buf.json(out,buf.view(&path)); buf.free(&path);
    buf.add(out,",\"scope\":\"one_synthetic_file_read_only\",\"granted\":");
    if (p.*.granted) { buf.add(out,"true"); } else { buf.add(out,"false"); }
    buf.add(out,",\"read_count\":"); buf.integer(out,p.*.reads as i64); buf.add(out,",\"denied_count\":"); buf.integer(out,p.*.denied as i64);
    buf.add(out,",\"error\":"); buf.json(out,buf.view(&p.*.error));
    buf.add(out,",\"proof_verified\":"); if (p.*.state==4) { buf.add(out,"true"); } else { buf.add(out,"false"); }
    buf.add(out,",\"file_removed\":"); if (!p.*.file_created && p.*.cleanup_ok) { buf.add(out,"true"); } else { buf.add(out,"false"); }
    buf.add(out,",\"writes\":false,\"shell\":false,\"remote_filesystem\":false}");
}
fn build_request(p: *Probe, key: []u8, port: i32) bool {
    let body: buf.Buffer=buf.make(49152); buf.add(&body,"{\"model\":"); buf.json(&body,buf.view(&p.*.model));
    buf.add(&body,",\"stream\":false,\"max_tokens\":1024,\"parallel_tool_calls\":false,\"messages\":"); buf.add(&body,buf.view(&p.*.history));
    // Keep identical tool definitions on both rounds for session fingerprint continuity.
    buf.add(&body,",\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read the single user-approved synthetic local file. No other files, writes or shell access.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"enum\":[\"bridge-probe.txt\"]}},\"required\":[\"path\"],\"additionalProperties\":false}}}],\"tool_choice\":\"auto\"}");
    buf.copy(&p.*.outgoing,"POST /v1/chat/completions HTTP/1.1\r\nHost: 127.0.0.1:"); buf.integer(&p.*.outgoing,port as i64);
    buf.add(&p.*.outgoing,"\r\nAuthorization: Bearer "); buf.add(&p.*.outgoing,key);
    buf.add(&p.*.outgoing,"\r\nX-Bridge-Session: "); buf.add(&p.*.outgoing,buf.view(&p.*.id));
    buf.add(&p.*.outgoing,"\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: "); buf.integer(&p.*.outgoing,body.len as i64);
    buf.add(&p.*.outgoing,"\r\n\r\n"); buf.add(&p.*.outgoing,buf.view(&body));
    let ok: bool=body.ok!=0 && p.*.outgoing.ok!=0; buf.free(&body); p.*.offset=0; buf.clear(&p.*.incoming); p.*.pending=false; return ok;
}
// Exact allowlist, not a string prefix or a path "normalizer". O_NOFOLLOW and
// O_NONBLOCK are used before fstat, so symlinks/devices/FIFOs cannot be read.
fn read_permitted(p: *Probe, id: []u8, provider: i32, model: []u8, path: []u8, out: *buf.Buffer) bool {
    buf.clear(out);
    if (!p.*.granted || p.*.directory_fd<0 || !p.*.file_created || p.*.state!=2 || p.*.reads!=0 || _zag_clock_monotonic_ms()>=p.*.deadline ||
        !buf.eq(id,buf.view(&p.*.id)) || provider!=p.*.provider || !buf.eq(model,buf.view(&p.*.model)) || !buf.eq(path,"bridge-probe.txt")) {
        p.*.denied=p.*.denied+1; p.*.changed=true; return false;
    }
    // Consume the grant even on an I/O failure. There is no retry authorization.
    p.*.granted=false;
    // Native shape first: dirfd open with Linux stat offsets, uid ownership
    // and a link-count of one. openat(2) cannot reach Darwin, so a failed
    // geteuid dispatches to the composed-path shape instead (projected mode
    // and size words; link and owner identity are then carried by the 0700
    // containment proven at prepare time). The shapes never cross-execute.
    let file: buf.Buffer=buf.make(32); buf.add(&file,"bridge-probe.txt"); buf.byte(&file,0);
    let fd: i64=_zag_raw_syscall(257,p.*.directory_fd,file.data as i64,131072 | 524288 | 2048,0,0,0); buf.free(&file);
    let ok: bool=false;
    let uid: i64=_zag_raw_syscall(107,0,0,0,0,0,0);
    if (fd>=0 && uid>=0) {
        let stat: *u64=_zag_malloc(144) as *u64;
        let rc: i64=_zag_raw_syscall(5,fd,stat as i64,0,0,0,0);
        ok=rc==0 && (stat[3] & 61440)==32768 && (stat[3] & 63)==0 && (stat[3] >> 32) as i64==uid && stat[2]==1 && stat[6]<128;
        _zag_free(stat as *i8);
    }
    if (!ok) {
        if (fd>=0) { net.close(fd); fd=0 - 1; }
        if (uid<0) {
            let full: buf.Buffer=buf.make(4096); buf.add(&full,buf.view(&p.*.root)); buf.add(&full,"/bridge-probe.txt"); buf.byte(&full,0);
            fd=_zag_raw_syscall(2,full.data as i64,657408,0,0,0,0);
            if (fd>=0) {
                let stat: *u32=_zag_malloc(144) as *u32;
                let rc: i64=_zag_raw_syscall(262,0 - 100,full.data as i64,stat as i64,256,0,0);
                ok=rc==0 && (stat[3] & 61440)==32768 && (stat[3] & 63)==0 && stat[6]<128;
                _zag_free(stat as *i8);
            }
            buf.free(&full);
        }
    }
    if (fd<0) { p.*.denied=p.*.denied+1; return false; }
    if (ok) {
        let got: i64=_zag_raw_syscall(0,fd,out.*.data as i64,out.*.cap as i64,0,0,0);
        ok=got>0 && got<out.*.cap as i64;
        if (ok) { out.*.len=got as i32; ok=buf.eq(buf.view(out),buf.view(&p.*.secret)); }
    }
    net.close(fd);
    if (!ok) { p.*.denied=p.*.denied+1; buf.clear(out); return false; }
    p.*.reads=1; p.*.changed=true; return true;
}
fn response(p: *Probe) void {
    let split: i32=buf.find(buf.view(&p.*.incoming),"\r\n\r\n",0);
    if (split<0 || !buf.prefix(buf.view(&p.*.incoming),"HTTP/1.1 200 ")) { terminal(p,5,"GATEWAY_OR_PROVIDER_REJECTED"); return; }
    let d: json.Document=json.parse(p.*.incoming.data[split+4..p.*.incoming.len]);
    let choices: i32=json.get(&d,0,"choices"); let message: i32=0 - 1;
    if (json.kind(&d,choices)==2 && d.tokens[choices].size==1) { message=json.get(&d,choices+1,"message"); }
    if (d.ok==0 || json.kind(&d,message)!=1 || !json.is_text(&d,json.get(&d,0,"model"),buf.view(&p.*.model))) { json.free(&d); terminal(p,5,"INVALID_TEST_RESPONSE"); return; }
    if (p.*.state==2) {
        let calls: i32=json.get(&d,message,"tool_calls"); let good: bool=json.kind(&d,calls)==2;
        if (good) { good=d.tokens[calls].size==1; }
        let call: i32=calls+1; let function: i32=json.get(&d,call,"function");
        let args: buf.Buffer=buf.make(1024); let call_id: buf.Buffer=buf.make(96); let path: buf.Buffer=buf.make(256); let text: buf.Buffer=buf.make(128);
        if (good) {
            json.field_text(&d,call,"id",&call_id); json.field_text(&d,function,"arguments",&args);
            good=call_id.ok!=0 && call_id.len>0 && args.ok!=0 && json.is_text(&d,json.get(&d,function,"name"),"read_file");
        }
        let parameters: json.Document=json.parse(buf.view(&args));
        if (good) { good=parameters.ok!=0 && json.kind(&parameters,0)==1 && parameters.tokens[0].size==1; }
        if (good) { json.field_text(&parameters,0,"path",&path); good=path.ok!=0 && read_permitted(p,buf.view(&p.*.id),p.*.provider,buf.view(&p.*.model),buf.view(&path),&text); }
        if (good) {
            p.*.history.len=p.*.history.len-1; buf.byte(&p.*.history,44); buf.add(&p.*.history,json.raw(&d,message));
            buf.add(&p.*.history,",{\"role\":\"tool\",\"tool_call_id\":"); buf.json(&p.*.history,buf.view(&call_id));
            buf.add(&p.*.history,",\"content\":"); buf.json(&p.*.history,buf.view(&text)); buf.add(&p.*.history,"}]");
            if (p.*.history.ok!=0) { p.*.state=3; p.*.pending=true; p.*.changed=true; }
            else { terminal(p,5,"TEST_HISTORY_LIMIT"); }
        } else { if (p.*.denied==0) { p.*.denied=1; } terminal(p,5,"READ_TOOL_DENIED_OR_MISSING"); }
        json.free(&parameters); buf.free(&args); buf.free(&call_id); buf.free(&path); buf.free(&text);
    } else {
        let text: buf.Buffer=buf.make(4096); json.field_text(&d,message,"content",&text);
        let ok: bool=text.ok!=0 && p.*.reads==1 && json.get(&d,message,"tool_calls")<0;
        let lo: i32=0; let hi: i32=text.len;
        while (lo<hi && (text.data[lo]==32 || text.data[lo]==10 || text.data[lo]==13)) { lo=lo+1; }
        while (hi>lo && (text.data[hi-1]==32 || text.data[hi-1]==10 || text.data[hi-1]==13)) { hi=hi-1; }
        ok=ok && buf.eq(text.data[lo..hi],buf.view(&p.*.secret));
        buf.free(&text); if (ok) { terminal(p,4,""); } else { terminal(p,5,"FILE_PROOF_MISMATCH"); }
    }
    json.free(&d);
}
fn pump(p: *Probe) void {
    if (p.*.state>=1 && p.*.state<=3 && _zag_clock_monotonic_ms()>=p.*.deadline) { terminal(p,5,"PERMISSION_EXPIRED"); return; }
    if (!active(p) || p.*.fd<0) { return; }
    if (p.*.offset<p.*.outgoing.len) {
        let count: i64=net.send(p.*.fd,(p.*.outgoing.data as i64+p.*.offset as i64) as *u8,p.*.outgoing.len-p.*.offset);
        if (count>0) { p.*.offset=p.*.offset+count as i32; }
        else if (!net.would_block(count)) { terminal(p,5,"TEST_TRANSPORT_WRITE_FAILED"); return; }
    }
    let turns: i32=0;
    while (turns<16) {
        if (p.*.incoming.len==p.*.incoming.cap) { terminal(p,5,"TEST_RESPONSE_LIMIT"); return; }
        let count: i64=net.recv(p.*.fd,(p.*.incoming.data as i64+p.*.incoming.len as i64) as *u8,p.*.incoming.cap-p.*.incoming.len);
        if (count>0) { p.*.incoming.len=p.*.incoming.len+count as i32; }
        else if (count==0) { net.close(p.*.fd); p.*.fd=0 - 1; response(p); return; }
        else if (net.would_block(count)) { return; }
        else { terminal(p,5,"TEST_TRANSPORT_READ_FAILED"); return; }
        turns=turns+1;
    }
}
fn free(p: *Probe) void {
    close_transport(p); remove_file(p); buf.free(&p.*.root); buf.free(&p.*.id); buf.free(&p.*.model); buf.free(&p.*.secret);
    buf.free(&p.*.history); buf.free(&p.*.outgoing); buf.free(&p.*.incoming); buf.free(&p.*.error);
}
