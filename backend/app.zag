                a.*.snapshot_pending = true; if (p.*.state == 2 && p.*.active_request >= 0) { cancel(a, p.*.active_request, "AUTH_REQUIRED", 401); } }
            else if (p.*.active_request >= 0 && p.*.state == 6) { cancel(a, p.*.active_request, "SITE_CHANGED", 502); }
