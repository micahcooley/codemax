fn read_client(a: *App, index: i32) void {
    let c: *connection.Client = &a.*.clients[index];
    if (c.*.phase >= 2) {
        let byte: buf.Buffer = buf.make(1); let rc: i64 = net.recv(c.*.fd, byte.data, 1); buf.free(&byte);
        if (rc == 0 || (rc < 0 && !net.would_block(rc))) { release(a, index); }
        else if (rc > 0) { if (c.*.phase == 2) { cancel(a, index, "PIPELINING_DENIED", 400); } release(a, index); } return;
    }
    if (c.*.input.len >= c.*.input.cap) { http_error(c, 413, "REQUEST_LIMIT"); return; }
    let amount: i32 = c.*.input.cap - c.*.input.len; if (amount > 32768) { amount = 32768; }
    let rc: i64 = net.recv(c.*.fd, &c.*.input.data[c.*.input.len], amount);
    if (rc == 0 || (rc < 0 && !net.would_block(rc))) { release(a, index); return; } if (rc < 0) { return; }
    c.*.input.len = c.*.input.len + rc as i32;
    if (c.*.phase == 0) {
        if (!http.parse(&c.*.headers, buf.view(&c.*.input), a.*.port, buf.view(&a.*.key))) { if (c.*.input.len > 16384) { http_error(c, 431, "HEADER_LIMIT"); } return; }
        if (c.*.headers.error != 0) { http_error(c, c.*.headers.error, "INVALID_HTTP_REQUEST"); return; }
        c.*.phase = 1;
    }
    let complete: i32 = c.*.headers.header_length + c.*.headers.content_length;
    if (c.*.input.len > complete) { http_error(c, 400, "PIPELINING_DENIED"); return; }
    if (c.*.input.len == complete) { route_http(a, index); }
}
fn pump_ipc(a: *App) void {
    let rounds: i32 = 0;
    while (rounds < 32) {
        let end: i32 = buf.find(buf.view(&a.*.ipc_in), "\n", 0); if (end < 0) { break; }
        ipc(a, a.*.ipc_in.data[0..end]); buf.drop_prefix(&a.*.ipc_in, end + 1); rounds = rounds + 1;
    }
}
fn flush_ipc(a: *App) void {
    if (a.*.ipc_out.len == 0) { a.*.last_ipc_write = _zag_clock_monotonic_ms(); return; }
    let n: i64 = _zag_raw_syscall(1, 1, a.*.ipc_out.data as i64, a.*.ipc_out.len as i64, 0, 0, 0);
    if (n > 0) { buf.drop_prefix(&a.*.ipc_out, n as i32); a.*.last_ipc_write = _zag_clock_monotonic_ms(); }
    else if (!net.would_block(n)) { a.*.running = false; }
}
fn start(a: *App) bool {
    if (!files.secure_root(buf.view(&a.*.root))) { _zag_eprintln("STATE_DIRECTORY_NOT_PRIVATE"); return false; }
    a.*.lock_fd = files.lock_state(buf.view(&a.*.root));
    if (a.*.lock_fd < 0) { _zag_eprintln("STATE_LOCK_FAILED"); return false; }
    if (!storage.load(buf.view(&a.*.root), a.*.dev, &a.*.port, &a.*.providers, &a.*.sessions)) { _zag_eprintln("STATE_READ_FAILED"); return false; }
    a.*.desired_port = a.*.port;
    if (!mcp.load(&a.*.mcp,buf.view(&a.*.root))) { _zag_eprintln("MCP_SETTINGS_READ_FAILED"); return false; }
    if (!prefs.load(buf.view(&a.*.root), &a.*.settings)) { _zag_eprintln("SETTINGS_READ_FAILED"); return false; }
    if (!token.load_or_create(buf.view(&a.*.root), &a.*.key)) { _zag_eprintln("LOCAL_TOKEN_FAILED"); return false; }
    a.*.listener = net.listen(a.*.port);
    if (a.*.listener < 0) { _zag_eprintln("LOOPBACK_BIND_FAILED"); return false; }
    if (!publish_connection(a)) { _zag_eprintln("CONNECTION_FILE_WRITE_FAILED"); return false; }
    if (!net.nonblocking(0) || !net.nonblocking(1)) { _zag_eprintln("IPC_NONBLOCKING_FAILED"); return false; }
    buf.add(&a.*.ipc_out, "{\"type\":\"hello\",\"protocol\":1,\"backend\":\"zag\",\"version\":\"0.1.0\",\"capabilities\":[\"chat-subset\",\"messages-subset\",\"responses-subset\",\"browser-evidence\"]}\n");
    if (a.*.settings.restore_tabs) {
        let i: i32 = 0; while (i < a.*.providers.count) { if (a.*.providers.items[i].open_tab) { a.*.providers.items[i].state = 1; host_event(a, "browser.open", &a.*.providers.items[i]); } i = i + 1; }
    }
    buf.add(&a.*.ipc_out, "{\"type\":\"host\",\"name\":\"platform.settings\",\"auto_start\":"); prefs.boolean(&a.*.ipc_out, a.*.settings.auto_start); buf.add(&a.*.ipc_out, "}\n");
    log_event(a, 0, "INFO", "backend.started", "Loopback gateway ready");
    a.*.snapshot_pending = true; return true;
}

fn drive_mcp(a: *App) void {
    mcp.tick(&a.*.mcp,&a.*.ipc_out);
    if (mcp_run.active(&a.*.mcp_run)) {
        let pi: i32=registry.index(&a.*.providers,a.*.mcp_run.provider);
        if (!mcp_context_valid(a,a.*.mcp_run.state!=1)) {
            // Only a still-authorized provider may cross intentional new-chat
            // navigation. Disabling exposure is never hidden by this exception.
            let preparing: bool=false;
            if (pi>=0 && a.*.mcp_run.state==1) {
                let p: *registry.Provider=&a.*.providers.items[pi];
                preparing=p.*.active_request>=0 && p.*.preparing && p.*.detected &&
                    p.*.exposed && p.*.scan_enabled && !p.*.dismissed && p.*.quota==0;
            }
            if (!preparing) { mcp_run.stop_active_tool(&a.*.mcp_run,&a.*.mcp,&a.*.ipc_out);mcp_run.terminal(&a.*.mcp_run,6,"MCP_PROVIDER_OR_CONVERSATION_CHANGED"); }
        }
    }
    mcp_run.pump(&a.*.mcp_run,&a.*.mcp,&a.*.ipc_out);
    if (a.*.mcp_run.cleanup_session) {
        let si: i32=sessions.find(&a.*.sessions,buf.view(&a.*.mcp_run.id));
        if (si>=0) {
            let pi: i32=registry.index(&a.*.providers,a.*.mcp_run.provider);
            if (pi>=0 && a.*.providers.items[pi].session==si) {
                let p: *registry.Provider=&a.*.providers.items[pi];if (p.*.active_request>=0) { cancel(a,p.*.active_request,"CANCELLED",409); }p.*.session=0 - 1;
            }
            a.*.sessions.items[si].status=4;buf.clear(&a.*.sessions.items[si].history);buf.clear(&a.*.sessions.items[si].response);a.*.dirty=true;
        }
        let n: i32=0;while (n<a.*.mcp.count) { if (a.*.mcp.servers[n].state==4) { mcp.stop(&a.*.mcp.servers[n],&a.*.ipc_out); }n=n+1; }
        a.*.mcp_run.cleanup_session=false;
    }
    if (mcp_run.active(&a.*.mcp_run) && a.*.mcp_run.pending && a.*.mcp_run.fd<0) {
        let slot: i32=0;while (slot<32 && a.*.clients[slot].fd>=0) { slot=slot+1; }
        if (slot==32) { mcp_run.terminal(&a.*.mcp_run,6,"CLIENT_LIMIT"); }
        else {
            let pair: *i32=_zag_malloc(8) as *i32;let rc: i64=_zag_raw_syscall(53,1,1 | 2048 | 524288,0,pair as i64,0,0);
            if (rc!=0) { mcp_run.terminal(&a.*.mcp_run,6,"PRIVATE_CLIENT_TRANSPORT_FAILED"); }
            else {
                a.*.mcp_run.fd=pair[0] as i64;
                if (!mcp_run.request(&a.*.mcp_run,buf.view(&a.*.key),a.*.port)) { net.close(pair[1] as i64);if (a.*.mcp_run.state!=8) { mcp_run.terminal(&a.*.mcp_run,6,"MCP_REQUEST_LIMIT"); } }
                else { a.*.clients[slot]=connection.make(pair[1] as i64); }
            }_zag_free(pair as *i8);
        }
    }
    if (a.*.mcp.changed || a.*.mcp_run.changed) { a.*.snapshot_pending=true;a.*.mcp.changed=false;a.*.mcp_run.changed=false; }
}

fn run(a: *App) void {
    let entries: *u64 = _zag_malloc(36 * 8) as *u64;
    while (a.*.running) {
        pump_ipc(a); drive_mcp(a); let now: i64 = _zag_clock_monotonic_ms(); suspend_idle(a, now);
        if (a.*.dirty) {
            if (!storage.save(buf.view(&a.*.root), a.*.desired_port, &a.*.providers, &a.*.sessions)) { a.*.persistence_failed = true; }
            a.*.dirty = false;
        }
        if (a.*.persistence_failed || a.*.ipc_out.ok == 0 || a.*.ipc_in.ok == 0) { _zag_eprintln("BOUNDED_STATE_OR_IPC_FAILURE"); a.*.running = false; break; }
        if (a.*.snapshot_pending && now - a.*.last_snapshot >= 200) {
            let state: buf.Buffer = buf.make(1048576); snapshot(a, &state);
            if (state.ok != 0) { buf.add(&a.*.ipc_out, "{\"type\":\"event\",\"name\":\"snapshot\",\"data\":"); buf.add(&a.*.ipc_out, buf.view(&state)); buf.add(&a.*.ipc_out, "}\n"); }
            else { a.*.running = false; }
            buf.free(&state); a.*.snapshot_pending = false; a.*.last_snapshot = now;
        }
        flush_ipc(a);
        if (a.*.ipc_out.len > 0 && now - a.*.last_ipc_write > 5000) { _zag_eprintln("HOST_BACKPRESSURE"); a.*.running = false; break; }
        // No active work: block in poll indefinitely. Pending state and live
        // requests add only bounded deadline/heartbeat wake-ups, not UI polling.
        let timeout: i32 = 0 - 1;
        if (a.*.settings.idle_minutes > 0 && a.*.providers.count > 0) { timeout = 30000; }
        if (a.*.snapshot_pending) { timeout = 200; }
        if (buf.find(buf.view(&a.*.ipc_in), "\n", 0) >= 0) { timeout = 0; }
        if (a.*.ipc_out.len > 0) { timeout = 1000; }
        entries[0] = net.poll_entry(0, 1); entries[1] = net.poll_entry(a.*.listener, 1);
        if (a.*.ipc_out.len > 0) { entries[2] = net.poll_entry(1, 4); } else { entries[2] = net.poll_entry(0 - 1, 0); }
        let i: i32 = 0;
        while (i < 32) {
            let c: *connection.Client = &a.*.clients[i];
            if (c.*.fd >= 0) {
                if (timeout < 0 || timeout > 1000) { timeout = 1000; }
                let events: u64 = 1; if (c.*.output.len > 0) { events = events | 4; }
                entries[i + 3] = net.poll_entry(c.*.fd, events);
            } else { entries[i + 3] = net.poll_entry(0 - 1, 0); }
            i = i + 1;
        }
        let mcp_events: u64=1;if (a.*.mcp_run.offset<a.*.mcp_run.outgoing.len) { mcp_events=mcp_events | 4; }
        entries[35]=net.poll_entry(a.*.mcp_run.fd,mcp_events);
        if ((mcp_run.active(&a.*.mcp_run) || mcp.busy(&a.*.mcp)) && (timeout<0 || timeout>1000)) { timeout=1000; }
        let ready: i64 = net.poll(entries, 36, timeout);
        if (ready < 0 && ready != 0 - 4) { a.*.running = false; break; }
        let input_events: i32 = net.poll_revents(entries[0]);
        if ((input_events & 1) != 0) {
            let space: i32 = a.*.ipc_in.cap - a.*.ipc_in.len;
            if (space <= 0) { a.*.running = false; break; }
            if (space > 65536) { space = 65536; }
            let got: i64 = _zag_raw_syscall(0, 0, (a.*.ipc_in.data as i64) + a.*.ipc_in.len as i64, space as i64, 0, 0, 0);
            if (got > 0) { a.*.ipc_in.len = a.*.ipc_in.len + got as i32; }
            else if (got == 0 || !net.would_block(got)) { a.*.running = false; }
        } else if ((input_events & 24) != 0) { a.*.running = false; }
        pump_ipc(a);
        if ((net.poll_revents(entries[1]) & 1) != 0) {
            let accepted: i32 = 0;
            while (accepted < 8) {
                let fd: i64 = net.accept(a.*.listener); if (fd < 0) { break; }
                let slot: i32 = 0; while (slot < 32 && a.*.clients[slot].fd >= 0) { slot = slot + 1; }
                if (slot == 32) { net.close(fd); } else { a.*.clients[slot] = connection.make(fd); }
                accepted = accepted + 1;
            }
        }
        i = 0; now = _zag_clock_monotonic_ms();
        while (i < 32) {
            let c: *connection.Client = &a.*.clients[i]; let flags: i32 = net.poll_revents(entries[i + 3]);
            if ((entries[i + 3] & 4294967295) != ((c.*.fd as u64) & 4294967295)) { flags = 0; }
            if (c.*.fd >= 0) {
                if ((flags & 1) != 0) { read_client(a, i); }
                if (c.*.fd >= 0 && (flags & 24) != 0) { release(a, i); }
                if (c.*.fd >= 0 && c.*.output.len > 0) {
                    let written: i64 = net.send(c.*.fd, c.*.output.data, c.*.output.len);
                    if (written > 0) { buf.drop_prefix(&c.*.output, written as i32); c.*.last_write = now; }
                    else if (!net.would_block(written)) { release(a, i); }
                }
                if (c.*.fd >= 0) {
                    if (c.*.phase == 3 && c.*.output.len == 0) { release(a, i); }
                    else if (now > c.*.deadline || (c.*.phase==2 && now>c.*.generation_limit) || (c.*.output.len > 0 && now - c.*.last_write > 5000)) {
                        if (c.*.phase == 2) { cancel(a, i, "TIMEOUT", 504); } else { release(a, i); }
                    } else if (c.*.phase == 2 && c.*.stream_open && now - c.*.last_ping >= 15000) {
                        if (c.*.output.len == 0) { c.*.last_write = now; }
                        sse.heartbeat(&c.*.output); c.*.last_ping = now;
                    }
                }
            }
            i = i + 1;
        }
    }
    _zag_free(entries as *i8);
}
fn free(a: *App) void {
    let i: i32 = 0;
    while (i < 32) { if (a.*.clients[i].fd >= 0) { if (a.*.clients[i].phase == 2) { cancel(a, i, "CANCELLED", 503); } connection.free(&a.*.clients[i]); } i = i + 1; }
    if (a.*.listener >= 0) { net.close(a.*.listener); a.*.listener = 0 - 1; }
    if (a.*.lock_fd >= 0) { let unpublished: bool = publish_connection(a); }
    // Try to deliver Stop actions once without blocking process termination.
    if (a.*.ipc_out.len > 0) { let wrote: i64 = _zag_raw_syscall(1, 1, a.*.ipc_out.data as i64, a.*.ipc_out.len as i64, 0, 0, 0); }
    if (!a.*.persistence_failed) { let saved: bool = storage.save(buf.view(&a.*.root), a.*.desired_port, &a.*.providers, &a.*.sessions); }
    if (a.*.lock_fd >= 0) { files.close(a.*.lock_fd); a.*.lock_fd = 0 - 1; }
    mcp_run.free(&a.*.mcp_run); mcp.free(&a.*.mcp); registry.free(&a.*.providers); sessions.free(&a.*.sessions); prefs.free(&a.*.settings); events.free(&a.*.events); _zag_free(a.*.clients as *i8);
    buf.free(&a.*.root); buf.free(&a.*.key); buf.free(&a.*.ipc_in); buf.free(&a.*.ipc_out);
}
