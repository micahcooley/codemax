                    buf.add(&a.*.ipc_out,",\"action\":{\"type\":\"discovery_policy\",\"document_id\":");buf.json(&a.*.ipc_out,buf.view(&p.*.document));buf.add(&a.*.ipc_out,",\"enabled\":false}}\n");
                }
