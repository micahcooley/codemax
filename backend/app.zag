    if (json.is_text(d, kind, "quota")) { p.*.state = 5; p.*.quota = 1; if (p.*.active_request >= 0) { cancel(a, p.*.active_request, "PROVIDER_RATE_LIMITED", 429); } a.*.snapshot_pending = true; return; }
    if (json.is_text(d, kind, "login_required")) { p.*.state = 2; if (p.*.active_request >= 0) { cancel(a, p.*.active_request, "AUTH_REQUIRED", 401); } a.*.snapshot_pending = true; return; }
