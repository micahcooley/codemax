@import("core/runtime.zag")
@import("core/buffer.zag") as buf
@import("app.zag") as app
fn main() i32 {
    let root: []u8 = _zag_getenv("BRIDGE_STATE_DIR");
    let dev: bool = false;
    if (_zag_strlen(root) == 0) { _zag_eprintln("BRIDGE_STATE_DIR_REQUIRED"); return 2; }
    let state: app.App = app.make(root, dev);
    if (!app.start(&state)) {
        // Do not persist partially read state after a failed/corrupt startup.
        state.persistence_failed = true; app.free(&state); return 3;
    }
    app.run(&state); let failed: bool = state.persistence_failed; app.free(&state);
    if (failed) { return 4; } return 0;
}
