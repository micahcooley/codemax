@import("runtime.zag")
@import("buffer.zag") as buf
fn rotate(x: u64, n: i32) u64 { return ((x >> n) | (x << (32 - n))) & 4294967295; }
fn digest(input: []u8, out: *buf.Buffer) bool {
    buf.clear(out); let n: i32 = _zag_strlen(input); if (n < 0 || n > 1048576) { return false; }
    let size: i32 = ((n + 72) / 64) * 64;
    let data: *u8 = _zag_malloc(size) as *u8; let k: *u64 = _zag_malloc(512) as *u64;
    let w: *u64 = _zag_malloc(512) as *u64; let h: *u64 = _zag_malloc(64) as *u64;
    let i: i32 = 0; while (i < size) { data[i] = 0; i = i + 1; }
    i = 0; while (i < n) { data[i] = input[i]; i = i + 1; } data[n] = 128;
    let bits: u64 = (n as u64) * 8; i = 0;
    while (i < 8) { data[size - 1 - i] = ((bits >> (i * 8)) & 255) as u8; i = i + 1; }
    k[0] = 1116352408;
    k[1] = 1899447441;
    k[2] = 3049323471;
    k[3] = 3921009573;
    k[4] = 961987163;
    k[5] = 1508970993;
    k[6] = 2453635748;
    k[7] = 2870763221;
    k[8] = 3624381080;
    k[9] = 310598401;
    k[10] = 607225278;
    k[11] = 1426881987;
    k[12] = 1925078388;
    k[13] = 2162078206;
    k[14] = 2614888103;
    k[15] = 3248222580;
    k[16] = 3835390401;
    k[17] = 4022224774;
    k[18] = 264347078;
    k[19] = 604807628;
    k[20] = 770255983;
    k[21] = 1249150122;
    k[22] = 1555081692;
    k[23] = 1996064986;
    k[24] = 2554220882;
    k[25] = 2821834349;
    k[26] = 2952996808;
    k[27] = 3210313671;
    k[28] = 3336571891;
    k[29] = 3584528711;
    k[30] = 113926993;
    k[31] = 338241895;
    k[32] = 666307205;
    k[33] = 773529912;
    k[34] = 1294757372;
    k[35] = 1396182291;
    k[36] = 1695183700;
    k[37] = 1986661051;
    k[38] = 2177026350;
    k[39] = 2456956037;
    k[40] = 2730485921;
    k[41] = 2820302411;
    k[42] = 3259730800;
    k[43] = 3345764771;
    k[44] = 3516065817;
    k[45] = 3600352804;
    k[46] = 4094571909;
    k[47] = 275423344;
    k[48] = 430227734;
    k[49] = 506948616;
    k[50] = 659060556;
    k[51] = 883997877;
    k[52] = 958139571;
    k[53] = 1322822218;
    k[54] = 1537002063;
    k[55] = 1747873779;
    k[56] = 1955562222;
    k[57] = 2024104815;
    k[58] = 2227730452;
    k[59] = 2361852424;
    k[60] = 2428436474;
    k[61] = 2756734187;
    k[62] = 3204031479;
    k[63] = 3329325298;
    h[0] = 1779033703;
    h[1] = 3144134277;
    h[2] = 1013904242;
    h[3] = 2773480762;
    h[4] = 1359893119;
    h[5] = 2600822924;
    h[6] = 528734635;
    h[7] = 1541459225;
    let offset: i32 = 0;
    while (offset < size) {
        i = 0; while (i < 16) { let at: i32 = offset + i * 4; w[i] = ((data[at] as u64) << 24) | ((data[at + 1] as u64) << 16) | ((data[at + 2] as u64) << 8) | (data[at + 3] as u64); i = i + 1; }
        while (i < 64) {
            let x: u64 = w[i - 15]; let y: u64 = w[i - 2];
            let s0: u64 = rotate(x, 7) ^ rotate(x, 18) ^ (x >> 3); let s1: u64 = rotate(y, 17) ^ rotate(y, 19) ^ (y >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 4294967295; i = i + 1;
        }
        let a: u64 = h[0]; let b: u64 = h[1]; let c: u64 = h[2]; let d: u64 = h[3];
        let e: u64 = h[4]; let f: u64 = h[5]; let g: u64 = h[6]; let z: u64 = h[7]; i = 0;
        while (i < 64) {
            let sum1: u64 = rotate(e, 6) ^ rotate(e, 11) ^ rotate(e, 25); let choice: u64 = (e & f) ^ ((e ^ 4294967295) & g);
            let t1: u64 = (z + sum1 + choice + k[i] + w[i]) & 4294967295;
            let sum0: u64 = rotate(a, 2) ^ rotate(a, 13) ^ rotate(a, 22); let majority: u64 = (a & b) ^ (a & c) ^ (b & c);
            let t2: u64 = (sum0 + majority) & 4294967295;
            z = g; g = f; f = e; e = (d + t1) & 4294967295; d = c; c = b; b = a; a = (t1 + t2) & 4294967295; i = i + 1;
        }
        h[0] = (h[0] + a) & 4294967295; h[1] = (h[1] + b) & 4294967295; h[2] = (h[2] + c) & 4294967295; h[3] = (h[3] + d) & 4294967295;
        h[4] = (h[4] + e) & 4294967295; h[5] = (h[5] + f) & 4294967295; h[6] = (h[6] + g) & 4294967295; h[7] = (h[7] + z) & 4294967295; offset = offset + 64;
    }
    let hex: []u8 = "0123456789abcdef"; i = 0;
    while (i < 8) { let shift: i32 = 28; while (shift >= 0) { buf.byte(out, hex[((h[i] >> shift) & 15) as i32]); shift = shift - 4; } i = i + 1; }
    _zag_free(data as *i8); _zag_free(k as *i8); _zag_free(w as *i8); _zag_free(h as *i8); return out.*.ok != 0;
}
