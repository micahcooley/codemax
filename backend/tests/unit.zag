@import("../core/runtime.zag")
@import("../core/buffer.zag") as buf
@import("../core/json.zag") as json
@import("../tools/parser.zag") as tools
@import("../security/local_token.zag") as token
@import("../security/validation.zag") as validation
@import("../sessions/context.zag") as context
@import("../protocol/normalized.zag") as normalized
@import("../core/sha256.zag") as sha
@import("../protocol/attachments.zag") as attachments
@import("../sessions/manager.zag") as sessions
@import("../storage/settings.zag") as settings
@import("../providers/registry.zag") as registry
@import("../detector/symbolic.zag") as symbolic
fn check(condition: bool, name: []u8) void {
    if (!condition) { _zag_eprintln(name); _zag_exit(1); }
}
fn json_cases() void {
    let a: json.Document = json.parse("{\"a\":1,\"\\u0061\":2}"); check(a.ok == 0, "duplicate decoded keys"); json.free(&a);
    let b: json.Document = json.parse("{\"x\":\"\\ud83c\\udfaf\",\"n\":[1,true,null]}"); check(b.ok != 0, "surrogate pair");
    let text: buf.Buffer = buf.make(64); json.field_text(&b, 0, "x", &text); check(buf.eq(buf.view(&text), "🎯"), "unicode decode"); buf.free(&text); json.free(&b);
    let c: json.Document = json.parse("[1,]"); check(c.ok == 0, "trailing comma"); json.free(&c);
    let d: json.Document = json.parse("01"); check(d.ok == 0, "leading zero"); json.free(&d);
    let e: json.Document = json.parse("\"\\ud800\""); check(e.ok == 0, "unpaired surrogate"); json.free(&e);
    let f: json.Document = json.parse("{\"z\":1,\"a\":2}"); let out: buf.Buffer = buf.make(100); json.canonical(&f, 0, &out);
    check(buf.eq(buf.view(&out), "{\"a\":2,\"z\":1}"), "canonical order"); buf.free(&out); json.free(&f);
}
fn tool_cases() void {
    let source: []u8 = "before<bridge-tool-call nonce=\"aabbccdd\">{\"id\":\"c1\",\"name\":\"read_file\",\"arguments\":{\"x\":\"</bridge-tool-call>\",\"nested\":[1,{\"y\":2}]}}</bridge-tool-call>after";
    let split: i32 = 0;
    while (split <= _zag_strlen(source)) {
        let p: tools.Parser = tools.make("aabbccdd", "|read_file|", true);
        tools.feed(&p, source[0..split]); tools.feed(&p, source[split.._zag_strlen(source)]); tools.finish(&p);
        check(!p.failed && p.calls == 1 && p.malformed == 0, "every two-chunk tool split"); tools.free(&p); split = split + 1;
    }
    let q: tools.Parser = tools.make("aabbccdd", "|read_file|", true);
    tools.feed(&q, "```\n<bridge-tool-call nonce=\"aabbccdd\">{\"id\":\"c1\",\"name\":\"read_file\",\"arguments\":{}}</bridge-tool-call>\n```");
    check(q.calls == 0, "fenced examples are not calls"); tools.free(&q);
    let r: tools.Parser = tools.make("fresh", "|read_file|", true);
    tools.feed(&r, source); tools.finish(&r); check(r.calls == 0, "wrong nonce"); tools.free(&r);
}
fn normalized_cases() void {
    let r: normalized.Request = normalized.make();
    normalized.decode(&r, "{\"model\":\"p1/test\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true}", 1, "r1", "s1");
    check(r.error.len == 0 && r.stream && r.message_count == 1, "OpenAI normalize"); normalized.free(&r);
    let a: normalized.Request = normalized.make();
    normalized.decode(&a, "{\"model\":\"p1/test\",\"max_tokens\":128,\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"c1\",\"content\":\"result\"}]}]}", 2, "r2", "s2");
    check(a.error.len == 0 && a.message_count == 1, "Anthropic tool result normalize"); normalized.free(&a);
    let b: normalized.Request = normalized.make();
    normalized.decode(&b, "{\"model\":\"p1/test\",\"input\":\"hello\",\"temperature\":0.2}", 3, "r3", "");
    check(buf.eq(buf.view(&b.error), "UNSUPPORTED_PARAMETER"), "unsupported controls fail closed"); normalized.free(&b);
}
fn receipt_and_attachment_cases() void {
    let hash: buf.Buffer = buf.make(64);
    check(sha.digest("", &hash) && buf.eq(buf.view(&hash), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), "SHA-256 vector 0 bytes");
    check(sha.digest("abc", &hash) && buf.eq(buf.view(&hash), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "SHA-256 vector 3 bytes");
    check(sha.digest("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", &hash) && buf.eq(buf.view(&hash), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"), "SHA-256 vector 55 bytes");
    check(sha.digest("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", &hash) && buf.eq(buf.view(&hash), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"), "SHA-256 vector 56 bytes");
    check(sha.digest("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", &hash) && buf.eq(buf.view(&hash), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"), "SHA-256 vector 64 bytes");
    check(sha.digest("", &hash) && buf.eq(buf.view(&hash), "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3"), "SHA-256 vector 1000 bytes");
    buf.free(&hash);
    check(attachments.valid_base64("Zg=="), "one byte base64");
    check(attachments.valid_base64("Zm8="), "two byte base64");
    check(attachments.valid_base64("Zm9v"), "three byte base64");
    check(!attachments.valid_base64("Zg=A"), "base64 internal padding denied");
    check(!attachments.valid_base64("Zh=="), "base64 nonzero tail bits denied");
    check(!attachments.valid_base64("===="), "base64 only padding denied");
    check(!attachments.valid_base64(""), "empty file payload denied");
    let store: sessions.Sessions = sessions.make();
    let first: i32 = sessions.add(&store, "s_unit", 1, "p1/test"); check(first == 0, "session allocation");
    let r: normalized.Request = normalized.make();
    normalized.decode(&r, "{\"model\":\"p1/test\",\"messages\":[{\"role\":\"user\",\"content\":\"first\"}]}", 1, "r_first", "s_unit");
    check(r.error.len == 0 && sessions.prepare(&store.items[0], &r) == 0, "session first turn");
    check(sessions.complete(&store.items[0], &r, "answer", "[]", false), "session receipt commit");
    let full: normalized.Request = normalized.make();
    normalized.decode(&full, "{\"model\":\"p1/test\",\"messages\":[{\"role\":\"user\",\"content\":\"first\"},{\"role\":\"assistant\",\"content\":\"answer\"},{\"role\":\"user\",\"content\":\"next\"}]}", 1, "r_next", "s_unit");
    check(full.error.len == 0 && sessions.prepare(&store.items[0], &full) > 0, "verified prefix skipped");
    let persisted: buf.Buffer = buf.make(131072); sessions.persist(&store, &persisted);
    check(buf.find(buf.view(&persisted), "first", 0) < 0 && buf.find(buf.view(&persisted), "answer", 0) < 0, "no transcript in persisted state");
    let bad: normalized.Request = normalized.make();
    normalized.decode(&bad, "{\"model\":\"p1/test\",\"messages\":[{\"role\":\"system\",\"content\":\"changed\"},{\"role\":\"user\",\"content\":\"next\"}]}", 1, "r_bad", "s_unit");
    check(sessions.prepare(&store.items[0], &bad) < 0, "changed system prefix refused");
    let temporary: i32 = sessions.add(&store, "s_rejected", 1, "p1/test"); sessions.discard_unstarted(&store, temporary);
    check(store.count == 1, "failed admission releases capacity");
    normalized.free(&bad); normalized.free(&full); normalized.free(&r); buf.free(&persisted); sessions.free(&store);
}
fn extended_protocol_cases() void {
    let r: normalized.Request = normalized.make();
    normalized.decode(&r, "{\"model\":\"p1/test\",\"input\":\"hello\",\"reasoning\":{\"effort\":\"thinking\"},\"tools\":[{\"type\":\"function\",\"name\":\"read_file\",\"parameters\":{\"type\":\"object\"}}],\"tool_choice\":{\"type\":\"function\",\"name\":\"read_file\"},\"parallel_tool_calls\":false}", 3, "r_tools", "");
    check(r.error.len == 0 && !r.parallel_tools && buf.eq(buf.view(&r.selected_tool), "read_file") && buf.eq(buf.view(&r.reasoning), "thinking"), "named Responses tool and reasoning"); normalized.free(&r);
    let image: normalized.Request = normalized.make();
    normalized.decode(&image, "{\"model\":\"p1/test\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Read this\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,Zg==\"}}]}]}", 1, "r_image", "");
    check(image.error.len == 0 && image.attachment_count == 1, "client inline attachment decoded");
    buf.copy(&image.nonce, "unit_nonce"); check(normalized.render_prompt(&image, 0) && image.pending_files.len > 2, "attachment passed only with new turn");
    check(buf.find(buf.view(&image.canonical), "Zg==", 0) < 0, "file bytes excluded from canonical transcript"); normalized.free(&image);
}


fn activity_cases() void {
    let r: registry.Registry=registry.make(); let idx: i32=registry.add(&r,"https://chat.example.test","https://chat.example.test/","Fixture");
    let a: json.Document=json.parse("{\"origin\":\"https://chat.example.test\",\"document_id\":\"test_doc\",\"controls\":[{\"id\":1,\"tag\":\"button\",\"label\":\"Stop generating\",\"visible\":true,\"disabled\":false}]}");
    check(symbolic.observe(&r.items[idx],&a,0) && r.items[idx].browser_busy,"visible stop sets manual activity"); json.free(&a);
    let b: json.Document=json.parse("{\"origin\":\"https://chat.example.test\",\"document_id\":\"test_doc\",\"controls\":[{\"id\":1,\"tag\":\"button\",\"label\":\"Stop generating\",\"visible\":false}]}");
    check(symbolic.observe(&r.items[idx],&b,0) && !r.items[idx].browser_busy,"hidden stop returns idle"); json.free(&b);
    let c: json.Document=json.parse("{\"origin\":\"https://chat.example.test\",\"document_id\":\"test_doc\",\"controls\":[{\"id\":1,\"tag\":\"button\",\"label\":\"Stop generating\",\"visible\":true,\"disabled\":true}]}");
    check(symbolic.observe(&r.items[idx],&c,0) && !r.items[idx].browser_busy,"disabled stop remains idle"); json.free(&c);
    let d: json.Document=json.parse("{\"origin\":\"https://chat.example.test\",\"document_id\":\"test_doc\",\"controls\":[{\"id\":2,\"role\":\"log\",\"label\":\"Assistant responses\",\"visible\":true,\"busy\":true}]}");
    check(symbolic.observe(&r.items[idx],&d,0) && r.items[idx].browser_busy,"assistant aria-busy is activity"); json.free(&d);
    let e: json.Document=json.parse("{\"origin\":\"https://chat.example.test\",\"document_id\":\"test_doc\",\"controls\":[{\"id\":2,\"role\":\"log\",\"label\":\"Assistant responses\",\"visible\":true,\"busy\":false}]}");
    check(symbolic.observe(&r.items[idx],&e,0) && !r.items[idx].browser_busy,"assistant completion is idle"); json.free(&e);
    registry.free(&r);
}

fn main() i32 {
    activity_cases();
    receipt_and_attachment_cases(); extended_protocol_cases();
    json_cases(); tool_cases(); normalized_cases();
    let origin: buf.Buffer = buf.make(512);
    check(validation.provider_origin("https://chat.example.com/", false, &origin), "HTTPS provider");
    check(!validation.provider_origin("https://user:secret@example.com/", false, &origin), "credential URL rejected");
    check(!validation.provider_origin("http://127.0.0.1:7340/", false, &origin), "insecure production URL rejected");
    check(validation.provider_origin("http://127.0.0.1:7340/", true, &origin), "explicit dev fixture");
    check(!context.fits(900, 100, 10, 1000), "context reservation");
    buf.free(&origin); _zag_println("native unit suite passed"); return 0;
}
