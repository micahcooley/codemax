@import("../core/runtime.zag")
@import("../core/buffer.zag") as buf
// All filenames are application constants, beneath a host-created 0700 directory.
// Portable Darwin notes: the macOS backend admits only exact Linux-shaped
// syscall tuples, fstat(2) has no Linux-layout projection there, and geteuid
// and flock cannot reach XNU at all (they fail closed with ENOSYS). Each
// check below therefore dispatches on geteuid first: a non-negative uid runs
// the native Linux shape verbatim (zero behavior change there), while a
// failed geteuid runs the Darwin shape (newfstatat-projected mode words,
// ownership by write access inside the 0700 directory, PID-file locking).
// The two shapes can never cross-execute, so neither platform can satisfy
// the other's checks by accident. Anything else fails closed with ENOSYS on
// Apple Silicon, so keep the admitted tuples exact.
fn path(root: []u8, name: []u8, out: *buf.Buffer) void {
    buf.clear(out); buf.add(out, root); buf.add(out, "/"); buf.add(out, name); buf.byte(out, 0);
}
fn fd_write(fd: i64, bytes: []u8) bool {
    let offset: i32 = 0; let calls: i32 = 0; let n: i32 = _zag_strlen(bytes);
    while (offset < n && calls < 4096) {
        let rc: i64 = _zag_raw_syscall(1, fd, _zag_slice_ptr(bytes[offset..n]) as i64, (n - offset) as i64, 0, 0, 0);
        calls = calls + 1;
        if (rc == 0 - 4) { continue; }
        if (rc <= 0) { return false; }
        offset = offset + rc as i32;
    }
    return offset == n;
}
fn close(fd: i64) void { let rc: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); }
// Fill exactly n bytes from the kernel entropy device. getrandom(2) is not
// admitted on Darwin; /dev/urandom reads are equivalent on both kernels.
fn random_fill(data: *u8, n: i32) bool {
    let p: buf.Buffer = buf.make(16); buf.add(&p, "/dev/urandom"); buf.byte(&p, 0);
    let fd: i64 = _zag_raw_syscall(2, p.data as i64, 657408, 0, 0, 0, 0); buf.free(&p);
    if (fd < 0) { return false; }
    let got: i32 = 0; let calls: i32 = 0;
    while (got < n && calls < 64) {
        let rc: i64 = _zag_raw_syscall(0, fd, (data as i64) + got as i64, (n - got) as i64, 0, 0, 0);
        calls = calls + 1;
        if (rc == 0 - 4) { continue; }
        if (rc <= 0) { close(fd); return false; }
        got = got + rc as i32;
    }
    close(fd); return got == n;
}
// Projected mode word for the pinned macOS toolchain (verified natively on
// directories, regular files and no-follow symlinks): newfstatat carries the
// Linux st_mode at u32 offset 3 and the low 32 size bits at u32 offset 6.
fn projected_mode(stat: *u32, kind: i64, mask: i64, perms: i64) bool {
    return (stat[3] & 61440) == kind && (stat[3] & mask) == perms;
}
fn load(root: []u8, name: []u8, out: *buf.Buffer) i32 {
    let p: buf.Buffer = buf.make(4096); path(root, name, &p);
    let fd: i64 = _zag_raw_syscall(2, p.data as i64, 657408, 0, 0, 0, 0);
    if (fd == 0 - 2) { buf.free(&p); return 0; }
    if (fd < 0) { buf.free(&p); return 0 - 1; }
    let stat: *u32 = _zag_malloc(144) as *u32;
    let uid: i64 = _zag_raw_syscall(107, 0, 0, 0, 0, 0, 0);
    let secure: bool = false;
    if (uid >= 0) {
        let rc: i64 = _zag_raw_syscall(5, fd, stat as i64, 0, 0, 0, 0);
        secure = rc == 0 && (stat[6] & 61440) == 32768 && (stat[6] & 63) == 0 && stat[7] as i64 == uid;
    } else {
        // Darwin shape: projected mode word; ownership is carried by the
        // 0700 directory proven at startup, which nobody else can write.
        // Mask 63 keeps the native no-group-or-other rule for 0600 files.
        let rc: i64 = _zag_raw_syscall(262, 0 - 100, p.data as i64, stat as i64, 256, 0, 0);
        secure = rc == 0 && projected_mode(stat, 32768, 63, 0);
    }
    _zag_free(stat as *i8); buf.free(&p);
    buf.clear(out);
    if (!secure) { close(fd); return 0 - 1; }
    let calls: i32 = 0;
    while (out.*.len < out.*.cap && calls < 4096) {
        let got: i64 = _zag_raw_syscall(0, fd, (out.*.data as i64) + out.*.len as i64, (out.*.cap - out.*.len) as i64, 0, 0, 0);
        calls = calls + 1;
        if (got == 0 - 4) { continue; }
        if (got == 0) { close(fd); return 1; }
        if (got < 0) { close(fd); return 0 - 1; }
        out.*.len = out.*.len + got as i32;
    }
    close(fd); out.*.ok = 0; return 0 - 1;
}
fn save(root: []u8, name: []u8, bytes: []u8) bool {
    let dest: buf.Buffer = buf.make(4096); let tmp: buf.Buffer = buf.make(4096);
    path(root, name, &dest); buf.add(&tmp, root); buf.add(&tmp, "/.write-"); buf.add(&tmp, name); buf.byte(&tmp, 45);
    let random: buf.Buffer = buf.make(16);
    if (!random_fill(random.data, 16)) { buf.free(&random); buf.free(&dest); buf.free(&tmp); return false; }
    let hex: []u8 = "0123456789abcdef"; let n: i32 = 0;
    while (n < 16) { buf.byte(&tmp, hex[(random.data[n] / 16) as i32]); buf.byte(&tmp, hex[(random.data[n] % 16) as i32]); n = n + 1; }
    buf.free(&random); buf.byte(&tmp, 0);
    if (tmp.ok == 0 || dest.ok == 0) { buf.free(&dest); buf.free(&tmp); return false; }
    // Exclusive random temporary file; stale crash files cannot block subsequent writes.
    let fd: i64 = _zag_raw_syscall(2, tmp.data as i64, 1 | 64 | 128 | 131072 | 524288, 384, 0, 0, 0);
    let ok: bool = fd >= 0;
    if (ok) {
        ok = fd_write(fd, bytes);
        if (_zag_raw_syscall(74, fd, 0, 0, 0, 0, 0) != 0) { ok = false; }
        close(fd);
        if (ok) { ok = _zag_raw_syscall(82, tmp.data as i64, dest.data as i64, 0, 0, 0, 0) == 0; }
        if (!ok) { let removed: i64 = _zag_raw_syscall(87, tmp.data as i64, 0, 0, 0, 0, 0); }
    }
    // Persist the rename itself, not just the file's contents.
    if (ok) {
        let dir: buf.Buffer = buf.make(4096); buf.add(&dir, root); buf.byte(&dir, 0);
        let dfd: i64 = _zag_raw_syscall(2, dir.data as i64, 65536 | 131072 | 524288, 0, 0, 0, 0);
        if (dfd < 0) { ok = false; } else { if (_zag_raw_syscall(74, dfd, 0, 0, 0, 0, 0) != 0) { ok = false; } close(dfd); }
        buf.free(&dir);
    }
    buf.free(&dest); buf.free(&tmp); return ok;
}

// Root must already exist and be private to this UID.
fn secure_root(root: []u8) bool {
    if (_zag_strlen(root) < 2 || _zag_strlen(root) > 3800 || root[0] != 47) { return false; }
    let p: buf.Buffer = buf.make(4096); buf.add(&p, root); buf.byte(&p, 0);
    let fd: i64 = _zag_raw_syscall(2, p.data as i64, 65536 | 131072 | 524288, 0, 0, 0, 0);
    if (fd < 0) { buf.free(&p); return false; }
    let stat: *u32 = _zag_malloc(144) as *u32;
    let uid: i64 = _zag_raw_syscall(107, 0, 0, 0, 0, 0, 0);
    let ok: bool = false;
    if (uid >= 0) {
        let rc: i64 = _zag_raw_syscall(5, fd, stat as i64, 0, 0, 0, 0);
        ok = rc == 0 && (stat[6] & 61440) == 16384 && (stat[6] & 511) == 448 && stat[7] as i64 == uid;
    } else {
        // Darwin shape: projected mode word plus a same-process write marker
        // only the directory owner (or root) can create.
        let rc: i64 = _zag_raw_syscall(262, 0 - 100, p.data as i64, stat as i64, 256, 0, 0);
        ok = rc == 0 && projected_mode(stat, 16384, 511, 448);
        if (ok) {
            let pid: i64 = _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
            buf.clear(&p); buf.add(&p, root); buf.add(&p, "/.owner-"); buf.integer(&p, pid); buf.byte(&p, 0);
            ok = p.ok != 0;
            if (ok) {
                let mfd: i64 = _zag_raw_syscall(2, p.data as i64, 1 | 64 | 128 | 131072 | 524288, 384, 0, 0, 0);
                if (mfd < 0) {
                    if (_zag_raw_syscall(87, p.data as i64, 0, 0, 0, 0, 0) != 0) { ok = false; }
                    else {
                        mfd = _zag_raw_syscall(2, p.data as i64, 1 | 64 | 128 | 131072 | 524288, 384, 0, 0, 0);
                        if (mfd < 0) { ok = false; }
                    }
                }
                if (ok) {
                    close(mfd);
                    ok = _zag_raw_syscall(87, p.data as i64, 0, 0, 0, 0, 0) == 0;
                }
            }
        }
    }
    _zag_free(stat as *i8); close(fd); buf.free(&p); return ok;
}

fn read_decimal(data: []u8) i64 {
    let value: i64 = 0; let i: i32 = 0; let digits: i32 = 0;
    while (i < data.len && digits < 19) {
        let c: u8 = data[i];
        if (c < 48 || c > 57) { break; }
        value = value * 10 + (c as i64 - 48); digits = digits + 1; i = i + 1;
    }
    if (digits == 0) { return 0 - 1; }
    return value;
}

// Singleton lock: native advisory flock where the kernel admits it, PID-file
// handoff where flock cannot reach XNU. The held-open fd is the lock,
// exactly as before; closing it on shutdown releases nothing else.
fn lock_state(root: []u8) i64 {
    let p: buf.Buffer = buf.make(4096); path(root, "instance.lock", &p);
    if (p.ok == 0) { buf.free(&p); return 0 - 1; }
    let uid: i64 = _zag_raw_syscall(107, 0, 0, 0, 0, 0, 0);
    if (uid >= 0) {
        let fd: i64 = _zag_raw_syscall(2, p.data as i64, 524288 | 131072 | 64 | 2, 384, 0, 0, 0);
        if (fd < 0) { buf.free(&p); return 0 - 1; }
        let stat: *u32 = _zag_malloc(144) as *u32;
        let rc: i64 = _zag_raw_syscall(5, fd, stat as i64, 0, 0, 0, 0);
        let secure: bool = rc == 0 && (stat[6] & 61440) == 32768 && (stat[6] & 63) == 0 && stat[7] as i64 == uid;
        _zag_free(stat as *i8);
        if (!secure) { close(fd); buf.free(&p); return 0 - 1; }
        let locked: i64 = _zag_raw_syscall(73, fd, 2 | 4, 0, 0, 0, 0);
        if (locked != 0) { close(fd); buf.free(&p); return 0 - 1; }
        buf.free(&p); return fd;
    }
    // Darwin shape: atomic exclusive create names the owner pid, and a stale
    // crash file is reclaimed after kill(pid, 0) reports ESRCH.
    let attempt: i32 = 0;
    while (attempt < 2) {
        let fd: i64 = _zag_raw_syscall(2, p.data as i64, 1 | 64 | 128 | 131072 | 524288, 384, 0, 0, 0);
        if (fd >= 0) {
            let pid: i64 = _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
            let num: buf.Buffer = buf.make(24); buf.integer(&num, pid);
            let ok: bool = num.ok != 0 && fd_write(fd, buf.view(&num));
            buf.free(&num);
            if (ok && _zag_raw_syscall(74, fd, 0, 0, 0, 0, 0) == 0) { buf.free(&p); return fd; }
            close(fd);
            let removed: i64 = _zag_raw_syscall(87, p.data as i64, 0, 0, 0, 0, 0);
            buf.free(&p); return 0 - 1;
        }
        if (attempt > 0) { buf.free(&p); return 0 - 1; }
        let rfd: i64 = _zag_raw_syscall(2, p.data as i64, 657408, 0, 0, 0, 0);
        if (rfd < 0) { buf.free(&p); return 0 - 1; }
        let content: buf.Buffer = buf.make(32);
        let got: i64 = _zag_raw_syscall(0, rfd, content.data as i64, 32, 0, 0, 0);
        close(rfd);
        if (got <= 0 || got > 32) { buf.free(&content); buf.free(&p); return 0 - 1; }
        let owner: i64 = read_decimal(content.data[0..(got as i32)]);
        buf.free(&content);
        if (owner <= 0) { buf.free(&p); return 0 - 1; }
        if (_zag_raw_syscall(62, owner, 0, 0, 0, 0, 0) == 0 - 3) {
            if (_zag_raw_syscall(87, p.data as i64, 0, 0, 0, 0, 0) != 0) { buf.free(&p); return 0 - 1; }
            attempt = attempt + 1;
        } else {
            buf.free(&p); return 0 - 1;
        }
    }
    buf.free(&p); return 0 - 1;
}
