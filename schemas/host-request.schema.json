{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private host request; provider callers do not choose their provider identity",
  "type": "object",
  "required": [
    "v",
    "id",
    "op",
    "params"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "op": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z._]+$"
    },
    "params": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
