{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal untrusted TNN shadow prediction",
  "type": "object",
  "required": [
    "evidence_version",
    "node",
    "confidence_ppm"
  ],
  "properties": {
    "evidence_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "node": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "confidence_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "additionalProperties": false
}
