{
  "name": "codemax",
  "version": "0.1.0-dev.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:native": "bash scripts/test-native.sh",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package:linux": "bash scripts/package-linux.sh",
    "doctor": "python3 scripts/doctor.py",
    "build:backend": "bash scripts/build-backend.sh",
    "release:gate": "python3 scripts/release-gate.py",
    "test:ui": "python3 tests/ui_browser.py",
    "check:zag-contracts": "python3 scripts/check-zag-contracts.py",
    "test:codemax": "python3 tests/codemax_ui.py",
    "test:chrome": "python3 tests/chrome_ui.py",
    "test:ux": "python3 tests/ux_audit.py",
    "test:progressive": "python3 tests/progressive_ux.py",
    "test:real-tools": "bash scripts/build-local-tools.sh && python3 tests/real/local_tools_test.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
